{
  "name": "@kova/agent",
  "version": "0.1.0",
  "description": "Kova AI Agent - Standalone agent package for AI-powered development",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "kova-agent": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "default": "./dist/cli/index.js"
    }
  },
  "scripts": {
    "dev": "bun --watch src/cli/bin.ts",
    "build": "tsc && bun run scripts/copy-assets.ts",
    "start": "bun dist/cli/bin.js",
    "test": "bun run vitest run",
    "test:watch": "bun run vitest",
    "clean": "rimraf dist",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "kova",
    "ai",
    "agent",
    "claude",
    "cli"
  ],
  "author": "Spreetail",
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.76",
    "ink": "^6.6.0",
    "ink-text-input": "^6.0.0",
    "minisearch": "^7.2.0",
    "react": ">=18.0.0",
    "trino-client": "^0.2.9",
    "yaml": "^2.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ]
}

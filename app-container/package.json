{
  "name": "kova-app-container",
  "version": "1.0.0",
  "description": "Container for running Claude Agent SDK and dev server for Kova apps",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc",
    "start": "bun dist/src/server.js",
    "dev": "bun --watch src/server.ts"
  },
  "dependencies": {
    "@kova/agent": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "^0.1.76",
    "fastify": "^5.3.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}

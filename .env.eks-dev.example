# =============================================================================
# Kova — Local Dev Against EKS (dev01-eks-kova)
# =============================================================================
# Copy to .env to run the backend locally while orchestrating containers
# on the EKS kova development cluster.
#
# Prerequisites:
#   1. kubectl context "dev01-eks-kova-admin" configured and accessible
#   2. ECR image pushed: 851725519214.dkr.ecr.us-east-1.amazonaws.com/scaled-innovation/kova-app-container:latest
#   3. Istio gateway + wildcard cert deployed on kova cluster
#   4. VPN connected (for VPC DNS resolution of *.kova.eks.dev01.tk.dev)

# --- Kubernetes ---
K8S_ENVIRONMENT=eks-dev

# --- LLM Provider (pick one) ---
LLM_PROVIDER=azure
ANTHROPIC_API_KEY=your-azure-foundry-api-key
# AGENT_MODEL=claude-sonnet-4-5  # Optional: default is claude-opus-4-6

# --- Database ---
DATABASE_URL=postgresql://kova:kova_dev_password@localhost:5433/kova

# --- Security (generate with: openssl rand -hex 32) ---
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
ENCRYPTION_KEY=your-64-character-hex-encryption-key-here-generate-with-openssl

# --- Spreetail Internal ---
PROGET_API_KEY=your-proget-api-key
DATA_PLATFORM_HOST=spreetail.routing.trino.galaxy.starburst.io
DATA_PLATFORM_USER=your_service_account_username
DATA_PLATFORM_PASSWORD=your_service_account_password

# --- Kova Plugin ---
GITLAB_TOKEN=your-gitlab-project-access-token
KOVA_PLUGIN_REPO=https://gitlab.com/spreetail/engineering/scaled-innovation/spreetail-claude-plugins.git
KOVA_PLUGIN_NAME=kova-plugin

# =============================================================================
# Kova Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# This single .env file is used by these Kova components:
#   - Backend server (zod-validated config in backend/src/config/index.ts)
#   - @kova/agent CLI
#   - App containers (via backend)
#
# NOTE: If values contains $, escape with \$ (Bun expands $VAR by default)
# =============================================================================

# -----------------------------------------------------------------------------
# AI / LLM (zod config in backend/src/config/index.ts)
# -----------------------------------------------------------------------------
#
# *** IMPORTANT: Do NOT set both ANTHROPIC_API_KEY and AWS Bedrock credentials.
# *** Choose (A) OR (B) to avoid conflicts. See documentation below for details.
# -----------------------------------------------------------------------------
AGENT_MODEL=claude-sonnet-4-5-20250929-v1:0
CLAUDE_CODE_USE_BEDROCK=1   # use Bedrock (1) OR direct Anthropic API (0)

# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
# >>> (A) Anthropic API Key (direct access to Anthropic models) <<<
# >>> use with CLAUDE_CODE_USE_BEDROCK=0 <<<
#
# Get your API key from: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-your-api-key-here
# <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

# >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
# >>> (B) AWS Bedrock (Bedrock models and unified credential management) <<<
# >>> use with CLAUDE_CODE_USE_BEDROCK=1 <<<
#
# AWS Bedrock (Alternative to ANTHROPIC_API_KEY)
# The Claude Agent SDK supports AWS Bedrock as an authentication method.
# To use Bedrock instead of the direct Anthropic API:
#
# 1. Run the helper script:
#    Linux/macOS: source ./scripts/refresh-aws-sso.sh
#    Windows:     .\scripts\refresh-aws-sso.ps1
#
# 2. The script automatically handles:
#    - AWS SSO login
#    - Credential export
#    - Setting all required environment variables
#
# 3. To override the default Bedrock model:
#    Linux/macOS: export BEDROCK_MODEL=us.anthropic.claude-opus-4-5-20251101-v1:0
#    Windows:     $env:BEDROCK_MODEL="us.anthropic.claude-opus-4-5-20251101-v1:0"
#
# Note: SSO credentials typically expire after 8-12 hours. Re-run the script to refresh.
#
# These are automatically set by the script (no need to uncomment):
#   CLAUDE_CODE_USE_BEDROCK=1   # use Bedrock instead of direct Anthropic API
#   AWS_AUTH_MODE=explicit      # "explicit" for local dev, "pod-identity" for EKS Pod Identity
#   AWS_REGION=aws-region
#   AGENT_MODEL=bedrock-model
#   AWS_ACCESS_KEY_ID=your-aws-access-key-id
#   AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
#   AWS_SESSION_TOKEN=your-aws-session-token
# <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

# -----------------------------------------------------------------------------
# Database (zod config in backend/src/config/index.ts)
#   Scope: Kova Backend Server
# -----------------------------------------------------------------------------
DATABASE_URL= postgresql://your-db-user:your-db-password@localhost:5433/kova

# -----------------------------------------------------------------------------
# Security (zod config in backend/src/config/index.ts)
#   Scope: Kova Backend Server
# -----------------------------------------------------------------------------
# Generate secrets with: openssl rand -hex 32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
ENCRYPTION_KEY=your-64-character-hex-encryption-key-here-generate-with-openssl

# -----------------------------------------------------------------------------
# Spreetail Internal Services - (zod config in backend/src/config/index.ts)
#   Scope: Kova Backend Server → App Containers
# -----------------------------------------------------------------------------
#
# Find these in GitLab CI/CD Variables:
# https://gitlab.com/spreetail/engineering/scaled-innovation/app-builder/-/settings/ci_cd
# -----------------------------------------------------------------------------

# ProGet API key for @spreetail npm packages
PROGET_API_KEY=your-proget-api-key

# Data Platform
DATA_PLATFORM_HOST=spreetail.routing.trino.galaxy.starburst.io
DATA_PLATFORM_USER=your_service_account_username
DATA_PLATFORM_PASSWORD=your_service_account_password # If values contains $, escape with \$
DATA_PLATFORM_PORT=443
DATA_PLATFORM_SSL=true

# GitLab token (for metadata/dbt model downloads)
# GITLAB_TOKEN=

# -----------------------------------------------------------------------------
# Backend Server (zod config in backend/src/config/index.ts)
#   Scope: Kova Backend Server
# -----------------------------------------------------------------------------
NODE_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3002
CORS_ORIGIN=http://localhost:5174

# -----------------------------------------------------------------------------
# Docker-Compliant Host Configuration (zod config in backend/src/config/index.ts)
#   Scope: Kova Backend Server
# -----------------------------------------------------------------------------
# 1 = socket mode (DOCKER_SOCKET), 0 = TCP mode (DOCKER_URL_HOST, DOCKER_URL_PORT)
DOCKER_USE_SOCKET=1

# (A) Socket mode (DOCKER_USE_SOCKET=1)
#   Linux/macOS: /var/run/docker.sock
#   Windows:     //./pipe/docker_engine
#   Rancher:     ~/.rd/docker.sock
DOCKER_SOCKET=/var/run/docker.sock

# (B) TCP mode (DOCKER_USE_SOCKET=0)
#   For Windows/Podman or remote Docker hosts
# DOCKER_URL_HOST=172.x.x.x
# DOCKER_URL_PORT=2375

# -----------------------------------------------------------------------------
# Container Configuration (zod config in backend/src/config/index.ts)
#   Scope: Kova Backend Server
# -----------------------------------------------------------------------------
CONTAINER_IMAGE=kova-app-container:latest
CONTAINER_NETWORK=kova-network
CONTAINER_IDLE_TIMEOUT_MS=900000
CONTAINER_SCAN_INTERVAL_MS=16000
CONTAINER_AGENT_PORT=3100
CONTAINER_DEV_PORT=3000
APPS_BASE_PATH=./backend/apps

# -----------------------------------------------------------------------------
# Preview App build (zod config in backend/src/config/index.ts)
#   Scope: Kova Backend Server
# -----------------------------------------------------------------------------
PREVIEW_DOMAIN=localhost
PREVIEW_PORT=8081

# -----------------------------------------------------------------------------
# Logging level
#   Scope: Kova Backend Server → App Containers
# -----------------------------------------------------------------------------
VERBOSE_AGENT_LOGGING=1

# -----------------------------------------------------------------------------
# Frontend (Vite) Configuration
#   Scope: Kova Frontend Server
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:3002

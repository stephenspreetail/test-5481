# =============================================================================
# Kova Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# This single .env file is used by these Kova components:
#   - Backend server (zod-validated config in backend/src/config/index.ts)
#   - App containers (via backend)
#
# NOTE: If values contains $, escape with \$ (Bun expands $VAR by default)
# =============================================================================

# -----------------------------------------------------------------------------
# Claude Agent SDK - LLM Provider Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Kova supports three LLM providers for the Claude Agent SDK.
# Choose ONE of the following configurations:

# =============================================================================
# OPTION 1: Azure Foundry (Spreetail Internal - Recommended)
# =============================================================================
# Azure OpenAI Service with Anthropic models via Foundry endpoint
# Defaults:
#   - Base URL: https://tk-dot-dev-foundry-resource.openai.azure.com/anthropic
#   - Model: claude-opus-4-6
LLM_PROVIDER=azure
ANTHROPIC_API_KEY=your-azure-foundry-api-key
# ANTHROPIC_BASE_URL=https://custom-foundry-resource.openai.azure.com/anthropic  # Optional: override default Spreetail URL
# AGENT_MODEL=claude-sonnet-4-5  # Optional: override default (use Sonnet for cost savings)

# =============================================================================
# OPTION 2: Direct Anthropic API
# =============================================================================
# Get your API key from: https://console.anthropic.com/settings/keys
# Defaults to claude-opus-4-6 model
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-api-key-here
# AGENT_MODEL=claude-opus-4-6  # Optional: explicitly set model (defaults to Opus 4.6)

# =============================================================================
# OPTION 3: AWS Bedrock
# =============================================================================
# Use Claude models via AWS Bedrock (requires AWS SSO or IAM credentials)
# Defaults to claude-sonnet-4-5-20250929-v1:0 model (cost-optimized)
#
# Setup for local development (SSO):
#   1. Run: source ./scripts/refresh-aws-sso.sh (Linux/macOS)
#           or .\scripts\refresh-aws-sso.ps1 (Windows)
#   2. Script handles SSO login and exports credentials
#   3. Re-run script when credentials expire (typically 8-12 hours)
#
# Configuration (set by script or manually):
# LLM_PROVIDER=bedrock
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=us-east-1
# AWS_AUTH_MODE=explicit
# AGENT_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0  # Optional: Sonnet (default) or Opus
#
# AWS_AUTH_MODE options:
#   - "explicit": Pass AWS credentials explicitly (local dev with SSO)
#   - "pod-identity": Let EKS Pod Identity inject credentials (production)
#
# For EKS deployment, set AWS_AUTH_MODE=pod-identity in ConfigMap

# =============================================================================
# Model Alias Overrides (Optional)
# =============================================================================
# The Claude Agent SDK supports model aliases (sonnet, opus, haiku, opusplan)
# that automatically map to provider-specific model names.
#
# Default mappings per provider:
#   Anthropic: claude-opus-4-6, claude-sonnet-4-5-20250929, claude-haiku-4-5
#   Azure:     claude-opus-4-6, claude-sonnet-4-5, claude-haiku-4-5
#   Bedrock:   us.anthropic.claude-opus-4-6-v1:0, us.anthropic.claude-sonnet-4-5-20250929-v1:0, us.anthropic.claude-haiku-4-5-v1:0
#
# You can override these defaults if needed:
# ANTHROPIC_DEFAULT_OPUS_MODEL=custom-opus-model
# ANTHROPIC_DEFAULT_SONNET_MODEL=custom-sonnet-model
# ANTHROPIC_DEFAULT_HAIKU_MODEL=custom-haiku-model
# CLAUDE_CODE_SUBAGENT_MODEL=custom-subagent-model

# =============================================================================
# Cleanup (Optional)
# =============================================================================
# If NOT using Bedrock, explicitly set these to empty to prevent conflicts
# with shell environment variables:
# CLAUDE_CODE_USE_BEDROCK=
# AWS_REGION=

# -----------------------------------------------------------------------------
# Database (zod config in backend/src/config/index.ts)
#   Scope: Kova Backend Server
# -----------------------------------------------------------------------------
# DB_AUTH_MODE controls how the backend authenticates to PostgreSQL:
#   - "password" (default): Uses DATABASE_URL connection string
#   - "iam": Uses AWS RDS IAM auth tokens (for EKS with Pod Identity)
#
# Password mode (local development):
DATABASE_URL=postgresql://your-db-user:your-db-password@localhost:5433/kova
#
# IAM mode (EKS deployment):
# DB_AUTH_MODE=iam
# DB_HOST=your-rds-instance.us-east-1.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=kova
# DB_USER=kova
# DB_REGION=us-east-1
# DB_SSL_CA_PATH=/path/to/rds-combined-ca-bundle.pem  # RDS CA bundle for SSL verification

# -----------------------------------------------------------------------------
# Security (zod config in backend/src/config/index.ts)
#   Scope: Kova Backend Server
# -----------------------------------------------------------------------------
# Generate secrets with: openssl rand -hex 32
# JWT_SECRET must be at least 32 characters
# ENCRYPTION_KEY must be exactly 64 hex characters (32 bytes)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
ENCRYPTION_KEY=your-64-character-hex-encryption-key-here-generate-with-openssl

# -----------------------------------------------------------------------------
# Spreetail Internal Services - (zod config in backend/src/config/index.ts)
#   Scope: Kova Backend Server → App Containers
# -----------------------------------------------------------------------------
#
# Find these in GitLab CI/CD Variables:
# https://gitlab.com/spreetail/engineering/scaled-innovation/app-builder/-/settings/ci_cd
# -----------------------------------------------------------------------------

# ProGet API key for @spreetail npm packages
PROGET_API_KEY=your-proget-api-key

# Data Platform
DATA_PLATFORM_HOST=spreetail.routing.trino.galaxy.starburst.io
DATA_PLATFORM_USER=your_service_account_username
DATA_PLATFORM_PASSWORD=your_service_account_password # If values contains $, escape with \$
DATA_PLATFORM_PORT=443
DATA_PLATFORM_SSL=true

# GitLab project access token for private plugin marketplace (read_repository scope)
GITLAB_TOKEN=your-gitlab-project-access-token
# HTTPS git URL of the plugin marketplace repo (cloned into app containers at startup)
KOVA_PLUGIN_REPO=https://gitlab.com/spreetail/engineering/scaled-innovation/spreetail-claude-plugins.git
# Plugin directory name within the marketplace repo
KOVA_PLUGIN_NAME=kova-plugin

# -----------------------------------------------------------------------------
# Backend Server (zod config in backend/src/config/index.ts)
#   Scope: Kova Backend Server
# -----------------------------------------------------------------------------
NODE_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3002
CORS_ORIGIN=http://localhost:5174

# Vite dev server proxy target (must match backend URL)
VITE_API_URL=http://localhost:3002

# -----------------------------------------------------------------------------
# Kubernetes Environment (optional, defaults to "local")
# -----------------------------------------------------------------------------
# Choose your Kubernetes environment (like LLM_PROVIDER):
# - "local": k3d development cluster (default)
#   • Uses hostNetwork for VPN compatibility
#   • Unique ports per app (31000 + appId)
#   • Preview: kova-app-{id}.dev.toolkit.co:8443
#
# - "eks-app-admin": Local dev orchestrating against dev01-eks-app-admin
#   • Standard ClusterIP networking
#   • Fixed ports (3100 agent, 3000 dev)
#   • Preview: app-{id}.app.eks.dev01.tk.dev
#
# - "eks-dev": EKS kova development cluster (dev01-eks-kova-admin)
#   • Standard ClusterIP + Istio networking
#   • ECR image, EBS storage
#   • Preview: app-{id}.kova.eks.dev01.tk.dev
#   • See .env.eks-dev.example for a minimal config
#
# - "eks-prod": EKS production cluster
#
# Each environment has sensible defaults for context, namespace, preview domain.
# K8S_ENVIRONMENT=local

# Optional overrides (use environment defaults if not set):
# K8S_CONTEXT=k3d-kova-dev
# K8S_NAMESPACE=kova-apps
# PREVIEW_DOMAIN=dev.toolkit.co
# PREVIEW_PORT=8443

# -----------------------------------------------------------------------------
# Logging
#   Scope: Kova Backend Server → App Containers
# -----------------------------------------------------------------------------
VERBOSE_AGENT_LOGGING=0

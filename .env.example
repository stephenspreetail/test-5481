# =============================================================================
# Kova Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# This single .env file is used by all Kova components:
#   - Backend server
#   - @kova/agent CLI
#   - App containers (via backend)
# =============================================================================

# -----------------------------------------------------------------------------
# Claude Agent SDK (REQUIRED)
# -----------------------------------------------------------------------------
# Get your API key from: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# AWS Bedrock (Alternative to ANTHROPIC_API_KEY)
# The Claude Agent SDK supports AWS Bedrock as an authentication method.
# To use Bedrock instead of the direct Anthropic API:
#
# 1. Run the helper script:
#    Linux/macOS: source ./scripts/refresh-aws-sso.sh
#    Windows:     .\scripts\refresh-aws-sso.ps1
#
# 2. The script automatically handles:
#    - AWS SSO login
#    - Credential export
#    - Setting all required environment variables
#
# 3. To override the default model:
#    Linux/macOS: export BEDROCK_MODEL=us.anthropic.claude-opus-4-5-20251101-v1:0
#    Windows:     $env:BEDROCK_MODEL = "us.anthropic.claude-opus-4-5-20251101-v1:0"
#
# Note: SSO credentials typically expire after 8-12 hours. Re-run the script to refresh.
#
# These are automatically set by the script (no need to uncomment):
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_AUTH_MODE=explicit
# AWS_REGION=us-east-1
# AGENT_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
#
# AWS Authentication Mode:
# - "explicit" (default, set by script): Pass credentials explicitly (local dev with SSO)
# - "pod-identity": Let containers discover credentials (EKS/K8s with Pod Identity)
# For EKS deployment, set AWS_AUTH_MODE=pod-identity in your ConfigMap/Deployment

# AI Provider API Keys (Optional - for multi-provider support)
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Model to use for agent queries (optional, default: claude-opus-4-5-20251101)
# Use sonnet for faster/cheaper responses during development
# AGENT_MODEL=claude-sonnet-4-20250514

# -----------------------------------------------------------------------------
# Database (REQUIRED for web platform)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://kova:kova_dev_password@localhost:5433/kova

# -----------------------------------------------------------------------------
# Security (REQUIRED for web platform)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
ENCRYPTION_KEY=your-64-character-hex-encryption-key-here-generate-with-openssl

# JWT token expiration (optional, defaults shown)
# For local development, consider longer values to avoid frequent re-login
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Spreetail Internal Services (REQUIRED for web platform)
# -----------------------------------------------------------------------------
# Find these in GitLab CI/CD Variables:
# https://gitlab.com/spreetail/engineering/scaled-innovation/app-builder/-/settings/ci_cd

# ProGet API key for @spreetail npm packages
PROGET_API_KEY=your-proget-api-key

# Data Platform (Starburst Galaxy / Trino)
DATA_PLATFORM_HOST=spreetail.routing.trino.galaxy.starburst.io
DATA_PLATFORM_USER=your_service_account_username
# NOTE: If password contains $, escape it with \$ (Bun expands $VAR by default)
# Example: pa$$word becomes pa\$\$word
DATA_PLATFORM_PASSWORD=your_service_account_password

# -----------------------------------------------------------------------------
# Backend Server (optional, has defaults)
# -----------------------------------------------------------------------------
# BACKEND_PORT=3002
# BACKEND_HOST=0.0.0.0
# NODE_ENV=development
# CORS_ORIGIN=http://localhost:5175

# -----------------------------------------------------------------------------
# Container Configuration (optional, has defaults)
# -----------------------------------------------------------------------------
# Container runtime socket path (Traefik uses this for route discovery)
# Usually no need to change - default works for most setups:
# - macOS/Windows: Rancher Desktop, Podman Desktop use default path
# - Linux: Docker, Podman rootful use default path
# - Linux Podman rootless: Set to $XDG_RUNTIME_DIR/podman/podman.sock
# DOCKER_SOCKET=/var/run/docker.sock
# CONTAINER_IMAGE=kova-app-container:latest
# CONTAINER_IDLE_TIMEOUT_MS=900000
# CONTAINER_NETWORK=kova-network
# CONTAINER_AGENT_PORT=3100
# CONTAINER_DEV_PORT=3000

# Where generated apps are stored on the host filesystem
# Relative paths are resolved from the project root
# APPS_BASE_PATH=./backend/apps

# -----------------------------------------------------------------------------
# Preview / Traefik (optional, has defaults)
# -----------------------------------------------------------------------------
# PREVIEW_DOMAIN=localhost
# PREVIEW_PORT=8081

# App Container for Kova
# Runs Claude Agent SDK + Dev Server for user apps
#
# Multi-stage build:
# 1. Build @kova/agent package from monorepo
# 2. Build app-container with the bundled agent

# SDK base image — CI passes the ECR-hosted kova-base-sdk image;
# local builds fall back to plain bun:1-debian (tsc must be installed manually).
ARG SDK_BASE=oven/bun:1-debian

# =============================================================================
# Stage 1: Build @kova/agent package
# =============================================================================
FROM ${SDK_BASE} AS agent-builder

WORKDIR /build

# Copy agent package files
COPY packages/agent/package.json ./

# Install dependencies
RUN bun install

# Copy agent source
COPY packages/agent/ ./

# Build TypeScript
RUN bun run build

# Create installable tarball
RUN bun pm pack

# =============================================================================
# Stage 2: Build app-container
# =============================================================================
FROM oven/bun:1-debian

# Install git (required by Claude Code CLI), Python, LibreOffice, and gosu for entrypoint
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    bash \
    gosu \
    python3 \
    python3-pip \
    python3-venv \
    libreoffice-calc-nogui \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages for xlsx skill (pandas, openpyxl)
RUN pip3 install --no-cache-dir --break-system-packages pandas openpyxl

# Install Claude Code CLI globally
RUN bun install -g @anthropic-ai/claude-code

# Create non-root user for running the agent
# Claude Code CLI refuses to run as root, so we run as 'kova' user via gosu (see entrypoint.sh)
RUN groupadd -g 1001 kova && \
    useradd -u 1001 -g kova -s /bin/bash -m kova

# Create app directory
WORKDIR /app

# Copy the built @kova/agent tarball from stage 1
COPY --from=agent-builder /build/*.tgz /tmp/kova-agent.tgz

# Copy package files
COPY app-container/package.json ./

# Replace workspace:* with the local tarball path, then install
RUN sed -i 's|"@kova/agent": "workspace:\*"|"@kova/agent": "file:/tmp/kova-agent.tgz"|' package.json && \
    bun install

# Copy source files
COPY app-container/ ./

# Build TypeScript
RUN bun run build

# Create workspace directory for user app files and set ownership
RUN mkdir -p /workspace && chown -R kova:kova /workspace

# Create .claude directory for config and set ownership
# Note: Skills are automatically copied by KovaAgent to /workspace/.claude/skills/ at runtime
RUN mkdir -p /home/kova/.claude && chown -R kova:kova /home/kova

# Set ownership of app directory
RUN chown -R kova:kova /app

# Configure npm registry for ProGet (internal packages)
# Copy .npmrc template to kova user's home directory
COPY --chown=kova:kova app-container/.npmrc.template /home/kova/.npmrc

# Also copy to workspace so it's available for user app builds
COPY --chown=kova:kova app-container/.npmrc.template /workspace/.npmrc

# Expose ports:
# 3000 - Dev server (user's app)
# 3100 - Agent server (Claude Agent SDK)
EXPOSE 3000 3100

# Set workspace as default working directory for agent operations
ENV WORKSPACE_DIR=/workspace
ENV HOME=/home/kova

# Install bun wrapper for dev server control handoff
# This allows Claude to run `bun dev` naturally while coordinating with managed dev server
COPY app-container/scripts/bun-wrapper.sh /usr/local/bin/bun-wrapper
RUN chmod +x /usr/local/bin/bun-wrapper && \
    # Make wrapper available as 'bun' by prepending to PATH
    echo 'export PATH="/usr/local/bin:$PATH"' >> /etc/profile && \
    # Create symlink so wrapper is found first
    mv /usr/local/bin/bun /usr/local/bin/bun-real 2>/dev/null || true && \
    ln -sf /usr/local/bin/bun-wrapper /usr/local/bin/bun

# =============================================================================
# ENTRYPOINT PATTERN FOR VOLUME PERMISSIONS
# =============================================================================
# We use the "gosu entrypoint pattern" to handle named volume permissions.
#
# Problem: Named volume for node_modules is created with root ownership,
# but Claude Code CLI refuses to run as root.
#
# Solution: Container starts as root, entrypoint.sh fixes volume ownership,
# then uses 'gosu' to drop privileges to 'kova' user before running the app.
#
# This is a Docker best practice used by official images like PostgreSQL/Redis.
# See entrypoint.sh for detailed documentation.
# =============================================================================

# Copy and enable entrypoint script
COPY app-container/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# NOTE: We intentionally do NOT use "USER kova" here.
# The entrypoint starts as root to fix volume permissions, then drops to kova.

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bun", "dist/src/server.js"]

{
  "name": "kova",
  "productName": "kova",
  "version": "0.9.0",
  "description": "Spreetail AI app builder",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/spreetail/engineering/scaled-innovation/app-builder.git"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "workspaces": [
    "packages/*",
    "backend",
    "app-container"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "dev:web": "bun run vite --config vite.web.config.mts",
    "build": "bun run build:backend && bun run build:web",
    "build:web": "bun run vite build --config vite.web.config.mts",
    "preview:web": "bun run vite preview --config vite.web.config.mts",
    "dev:backend": "bun --env-file=.env --watch backend/src/index.ts",
    "build:backend": "bun run --cwd backend build",
    "start:backend": "bun run --cwd backend start",
    "dev:full": "concurrently -k \"bun run dev:backend\" \"bun run dev:web\"",
    "dev:reset": "bun run --cwd backend clear-apps && bun run --cwd backend db:reset",
    "ts": "bun run tsc -p tsconfig.app.json --noEmit",
    "lint": "bun run oxlint --fix",
    "lint:fix": "bun run oxlint --fix --fix-suggestions --fix-dangerously",
    "imports:fix": "bun run biome check . --write --formatter-enabled=false --linter-enabled=false --organize-imports-enabled=true",
    "db:generate": "bun run --cwd backend db:generate",
    "db:push": "bun run --cwd backend db:push",
    "db:studio": "bun run --cwd backend db:studio",
    "prettier:check": "bun run prettier --check .",
    "prettier": "bun run prettier --write .",
    "presubmit": "bun run prettier:check && bun run lint",
    "test": "bun run vitest run",
    "test:watch": "bun run vitest",
    "test:ui": "bun run vitest --ui",
    "init-precommit": "husky",
    "container:build": "docker build -f Dockerfile.appcontainer -t kova-app-container:latest .",
    "container:import": "k3d image import kova-app-container:latest -c kova-dev",
    "container:rebuild": "bun run container:build && bun run container:import",
    "docker:build": "docker build -f Dockerfile.backend -t localhost:5555/kova-backend:latest . && docker build -f Dockerfile.web -t localhost:5555/kova-web:latest .",
    "docker:push": "docker push localhost:5555/kova-backend:latest && docker push localhost:5555/kova-web:latest",
    "kova:up": "./scripts/kova-up.sh",
    "kova:down": "./scripts/kova-down.sh",
    "kova:rebuild": "./scripts/kova-rebuild.sh",
    "kova:logs": "./scripts/kova-logs.sh",
    "kova:status": "./scripts/kova-status.sh",
    "start:podman": "powershell -ExecutionPolicy Bypass -File ./scripts/start-podman.ps1",
    "sandbox": "bun run sandbox/run.ts",
    "sandbox:test": "bun run sandbox/run.ts",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test e2e/auth.smoke.spec.ts"
  },
  "keywords": [],
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.0",
    "@types/fs-extra": "^11.0.4",
    "@types/glob": "^8.1.0",
    "@types/kill-port": "^2.0.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitest/ui": "^3.1.1",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.30.6",
    "happy-dom": "^17.4.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "oxlint": "^1.8.0",
    "prettier": "3.5.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vite": "^5.4.17",
    "vitest": "^3.1.1",
    "ws": "^8.18.3"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^3.0.15",
    "@ai-sdk/anthropic": "^2.0.4",
    "@ai-sdk/azure": "^2.0.17",
    "@ai-sdk/google": "^2.0.6",
    "@ai-sdk/google-vertex": "3.0.16",
    "@ai-sdk/openai": "2.0.15",
    "@ai-sdk/openai-compatible": "^1.0.8",
    "@ai-sdk/provider-utils": "^3.0.3",
    "@ai-sdk/xai": "^2.0.16",
    "@babel/parser": "^7.28.5",
    "@biomejs/biome": "^1.9.4",
    "@kubernetes/client-node": "^1.4.0",
    "@lexical/react": "^0.33.1",
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@monaco-editor/react": "^4.7.0-rc.0",
    "@openrouter/ai-sdk-provider": "^1.1.2",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.13",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.2",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-switch": "^1.2.0",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toggle": "^1.1.3",
    "@radix-ui/react-toggle-group": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@shikijs/langs": "^3.2.1",
    "@shikijs/themes": "^3.2.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.3",
    "@tanstack/react-query": "^5.75.5",
    "@tanstack/react-router": "^1.114.34",
    "@types/uuid": "^10.0.0",
    "@vercel/sdk": "^1.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "ai": "^5.0.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.41.0",
    "esbuild-register": "^3.6.0",
    "fastest-levenshtein": "^1.0.16",
    "fix-path": "^4.0.0",
    "framer-motion": "^12.6.3",
    "geist": "^1.3.1",
    "glob": "^11.0.2",
    "isomorphic-git": "^1.30.1",
    "jose": "^6.1.3",
    "jotai": "^2.12.2",
    "kill-port": "^2.0.1",
    "lexical": "^0.33.1",
    "lexical-beautiful-mentions": "^0.1.47",
    "lucide-react": "^0.487.0",
    "monaco-editor": "^0.52.2",
    "openai": "^4.91.1",
    "posthog-js": "^1.236.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.7",
    "react-shiki": "^0.9.0",
    "recast": "^0.23.11",
    "remark-gfm": "^4.0.1",
    "shell-env": "^4.0.1",
    "shiki": "^3.2.1",
    "sonner": "^2.0.3",
    "stacktrace-js": "^2.0.2",
    "tailwind-merge": "^3.1.0",
    "tailwindcss": "^4.1.3",
    "tw-animate-css": "^1.2.5",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,astro,svelte}": "oxlint",
    "*.{js,css,md,ts,tsx,jsx,json}": "prettier --write"
  }
}

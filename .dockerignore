# =============================================================================
# Docker Build Context Exclusions (default - used by production Dockerfile)
# =============================================================================
# Includes: backend, src, packages/agent (needed for full app build)
# See Dockerfile.appcontainer.dockerignore for app-container specific exclusions

# Exclude all node_modules (will be installed fresh in container)
**/node_modules

# Exclude build outputs (will be built fresh in container)
**/dist
**/.vite

# Exclude directories not needed in production image (keep app-container/package.json for workspace resolution)
app-container/src
app-container/dist
app-container/scripts
app-container/entrypoint.sh
app-container/.npmrc.template
app-container/.dockerignore
e2e-tests
testing
traefik
sandbox
scripts
!scripts/docker-entrypoint.sh
manifests
docs

# Exclude logs and temp files
*.log
*.tmp

# Exclude environment files (secrets!)
.env
.env.*
!.env.example

# Exclude git directory
.git
.gitignore

# Exclude IDE and editor files
.vscode
.idea
*.swp
*.swo

# Exclude documentation
*.md

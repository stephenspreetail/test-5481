# =============================================================================
# SDK base image for Kova build stages
# =============================================================================
# Extends oven/bun:1-debian with build-time dependencies (tsc, node-gyp).
# Built in .pre and used as the builder stage in Dockerfile.appcontainer.
#
# Build:  docker build -f Dockerfile.base-sdk -t kova/kova-base-sdk:latest .
# =============================================================================

FROM oven/bun:1-debian

# CI registry mirror may inject stale third-party apt repos (docker.com,
# microsoft.com) into sources.list.d/ — remove them but keep the base
# image's own debian.sources (oven/bun:1-debian is trixie with DEB822 format).
ENV DEBIAN_FRONTEND=noninteractive
RUN find /etc/apt/sources.list.d/ -type f ! -name 'debian.sources' -delete 2>/dev/null; \
    bun install -g typescript \
    && apt-get update -qq \
    && apt-get install -y -qq python3 make g++ git \
    && rm -rf /var/lib/apt/lists/*

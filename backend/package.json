{
  "name": "kova-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Kova web backend API server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --env-file=../.env --watch src/index.ts",
    "dev:node": "dotenv -e ../.env -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "bun run dist/index.js",
    "db:generate": "bun run drizzle-kit generate",
    "db:migrate": "bun run drizzle-kit migrate",
    "db:push": "bun run drizzle-kit push",
    "db:studio": "bun run drizzle-kit studio",
    "db:reset": "bun run scripts/reset-db.ts && bun run drizzle-kit push",
    "clear-apps": "bun run scripts/clear-apps.ts",
    "test": "bun run vitest run",
    "test:watch": "bun run vitest",
    "seed:dev-user": "bun run scripts/seed-dev-user.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.74",
    "@anthropic-ai/sdk": "^0.71.2",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/websocket": "^11.0.1",
    "@kova/agent": "workspace:*",
    "bcryptjs": "^2.4.3",
    "dockerode": "^4.0.2",
    "drizzle-orm": "^0.41.0",
    "fastify": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/dockerode": "^3.3.31",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.30.6",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}

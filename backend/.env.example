# Server Configuration
PORT=3002
HOST=0.0.0.0
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://kova:kova_dev_password@localhost:5433/kova

# JWT Configuration
# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption Key for secrets (32 bytes = 64 hex characters)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-64-character-hex-encryption-key-here

# Docker Configuration
DOCKER_SOCKET=/var/run/docker.sock
APPS_BASE_PATH=/data/kova-apps

# CORS
CORS_ORIGIN=http://localhost:5175

# Claude Agent SDK
# Get your API key from: https://console.anthropic.com/settings/keys
# Optional if you've already authenticated via the CLI with: claude
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
# Model to use for agent queries (optional)
AGENT_MODEL=claude-sonnet-4-20250514

# App Container Configuration
# Docker image for app containers (built from app-container directory)
APP_CONTAINER_IMAGE=kova-app-container:latest
# Idle timeout in milliseconds (default: 30 minutes = 1800000ms)
APP_CONTAINER_IDLE_TIMEOUT_MS=1800000
# ProGet API key for internal npm packages (passed to app containers)
PROGET_API_KEY=your-proget-api-key-here

# Container Orchestrator Configuration
# Network name for container communication (must match docker-compose network)
CONTAINER_NETWORK=kova-network
# Domain for preview URLs (e.g., app-123.localhost)
PREVIEW_DOMAIN=localhost
# Port for preview access via Traefik
PREVIEW_PORT=8081
# Internal ports (inside containers)
AGENT_PORT=3100
DEV_SERVER_PORT=3000
